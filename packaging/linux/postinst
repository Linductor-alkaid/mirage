#!/bin/sh
# Mirage .deb postinst (M5-11, DEC-031): best-effort session setup.
# Nothing here may fail the package install: every step is conditional and
# non-fatal — the shipped binaries run without any of this state.
set -e

# CEF chrome-sandbox: the M5-01 sandbox policy ships the setuid helper when
# the desktop shell is installed (M5-11 packaging delivery). Best effort:
# only when the file exists, and never fatal.
if [ -f /usr/lib/mirage/chrome-sandbox ]; then
    chown root:root /usr/lib/mirage/chrome-sandbox || true
    chmod 4755 /usr/lib/mirage/chrome-sandbox || true
fi

exit 0
