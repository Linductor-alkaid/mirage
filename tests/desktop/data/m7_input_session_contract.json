{
  "contract": "input_session",
  "decision": "DEC-110",
  "budget_version": 1,
  "receipt_version": 1,
  "capabilities": [
    "software_injection",
    "smooth_move",
    "timed_press",
    "independent_modifiers",
    "cross_observation_hold",
    "hold_capture",
    "key_repeat",
    "ime_state",
    "ime_control",
    "kernel_virtual_device",
    "external_hid"
  ],
  "session_key_vocabulary": {
    "bare_modifiers": ["ctrl", "alt", "shift", "meta"],
    "sided_modifiers": [
      "ctrlleft", "ctrlright",
      "altleft", "altright",
      "shiftleft", "shiftright",
      "metaleft", "metaright"
    ],
    "named_base_keys": [
      "enter", "tab", "escape", "backspace", "delete", "insert",
      "home", "end", "pageup", "pagedown",
      "left", "right", "up", "down", "space"
    ],
    "function_keys": "f1..f12",
    "note": "base keys reuse the InputProvider KeySym base vocabulary; chord prefixes are not session names because sessions compose modifiers as standalone commands",
    "invalid_names": [
      "",
      "ctrl+c",
      "shift+tab",
      "meta+",
      "shiftleftt",
      "ctrlmiddle",
      "metalefty",
      "f13",
      "Modifiers",
      "al t"
    ]
  },
  "budgets": {
    "max_held_inputs": 4,
    "max_session_commands": 64,
    "max_path_points": 64,
    "default_path_points": 32,
    "min_move_duration_ms": 50,
    "max_move_duration_ms": 2000,
    "max_press_dwell_ms": 1500,
    "max_idle_ms": 15000,
    "max_session_total_ms": 60000,
    "default_move_profile": "minimum_jerk_v1"
  },
  "states": ["ready", "executing", "awaiting_feedback", "releasing", "released", "fenced"],
  "events": [
    "admit",
    "command_admitted",
    "command_settled",
    "observe",
    "observe_repeat",
    "release_requested",
    "release_confirmed",
    "release_failed"
  ],
  "transitions": [
    {"from": "ready", "event": "admit", "to": "executing"},
    {"from": "ready", "event": "command_admitted", "to": "rejected"},
    {"from": "ready", "event": "command_settled", "to": "rejected"},
    {"from": "ready", "event": "observe", "to": "rejected"},
    {"from": "ready", "event": "observe_repeat", "to": "rejected"},
    {"from": "ready", "event": "release_requested", "to": "releasing"},
    {"from": "ready", "event": "release_confirmed", "to": "rejected"},
    {"from": "ready", "event": "release_failed", "to": "rejected"},
    {"from": "executing", "event": "admit", "to": "rejected"},
    {"from": "executing", "event": "command_admitted", "to": "executing"},
    {"from": "executing", "event": "command_settled", "to": "executing"},
    {"from": "executing", "event": "observe", "to": "awaiting_feedback"},
    {"from": "executing", "event": "observe_repeat", "to": "rejected"},
    {"from": "executing", "event": "release_requested", "to": "releasing"},
    {"from": "executing", "event": "release_confirmed", "to": "rejected"},
    {"from": "executing", "event": "release_failed", "to": "rejected"},
    {"from": "awaiting_feedback", "event": "admit", "to": "rejected"},
    {"from": "awaiting_feedback", "event": "command_admitted", "to": "executing"},
    {"from": "awaiting_feedback", "event": "command_settled", "to": "rejected"},
    {"from": "awaiting_feedback", "event": "observe", "to": "rejected"},
    {"from": "awaiting_feedback", "event": "observe_repeat", "to": "awaiting_feedback"},
    {"from": "awaiting_feedback", "event": "release_requested", "to": "releasing"},
    {"from": "awaiting_feedback", "event": "release_confirmed", "to": "rejected"},
    {"from": "awaiting_feedback", "event": "release_failed", "to": "rejected"},
    {"from": "releasing", "event": "admit", "to": "rejected"},
    {"from": "releasing", "event": "command_admitted", "to": "rejected"},
    {"from": "releasing", "event": "command_settled", "to": "rejected"},
    {"from": "releasing", "event": "observe", "to": "rejected"},
    {"from": "releasing", "event": "observe_repeat", "to": "rejected"},
    {"from": "releasing", "event": "release_requested", "to": "releasing"},
    {"from": "releasing", "event": "release_confirmed", "to": "released"},
    {"from": "releasing", "event": "release_failed", "to": "fenced"},
    {"from": "released", "event": "admit", "to": "rejected"},
    {"from": "released", "event": "command_admitted", "to": "rejected"},
    {"from": "released", "event": "command_settled", "to": "rejected"},
    {"from": "released", "event": "observe", "to": "rejected"},
    {"from": "released", "event": "observe_repeat", "to": "rejected"},
    {"from": "released", "event": "release_requested", "to": "rejected"},
    {"from": "released", "event": "release_confirmed", "to": "rejected"},
    {"from": "released", "event": "release_failed", "to": "rejected"},
    {"from": "fenced", "event": "admit", "to": "rejected"},
    {"from": "fenced", "event": "command_admitted", "to": "rejected"},
    {"from": "fenced", "event": "command_settled", "to": "rejected"},
    {"from": "fenced", "event": "observe", "to": "rejected"},
    {"from": "fenced", "event": "observe_repeat", "to": "rejected"},
    {"from": "fenced", "event": "release_requested", "to": "rejected"},
    {"from": "fenced", "event": "release_confirmed", "to": "rejected"},
    {"from": "fenced", "event": "release_failed", "to": "rejected"}
  ],
  "command_matrix": [
    {"case": "tap_base_key_without_dwell", "kind": "key_tap", "key": "tab", "capabilities": ["software_injection"], "expect": "ok"},
    {"case": "tap_base_key_with_dwell", "kind": "key_tap", "key": "a", "dwell_ms": 200, "capabilities": ["software_injection", "timed_press"], "expect": "ok"},
    {"case": "tap_dwell_requires_timed_press", "kind": "key_tap", "key": "a", "dwell_ms": 200, "capabilities": ["software_injection"], "expect": "unsupported_platform"},
    {"case": "tap_dwell_over_bound", "kind": "key_tap", "key": "a", "dwell_ms": 1501, "capabilities": ["software_injection", "timed_press"], "expect": "result_too_large"},
    {"case": "modifier_tap_requires_capability", "kind": "key_tap", "key": "shift", "capabilities": ["software_injection"], "expect": "unsupported_platform"},
    {"case": "modifier_tap_ok", "kind": "key_tap", "key": "shift", "capabilities": ["software_injection", "independent_modifiers"], "expect": "ok"},
    {"case": "sided_modifier_down_requires_capability", "kind": "key_down", "key": "altleft", "capabilities": ["software_injection", "cross_observation_hold"], "expect": "unsupported_platform"},
    {"case": "sided_modifier_down_ok", "kind": "key_down", "key": "altleft", "capabilities": ["kernel_virtual_device", "independent_modifiers"], "expect": "ok"},
    {"case": "bare_modifier_down_ok", "kind": "key_down", "key": "alt", "capabilities": ["independent_modifiers", "software_injection"], "expect": "ok"},
    {"case": "modifier_up_ok", "kind": "key_up", "key": "altright", "capabilities": ["independent_modifiers", "software_injection"], "expect": "ok"},
    {"case": "base_key_down_requires_hold", "kind": "key_down", "key": "a", "capabilities": ["software_injection"], "expect": "unsupported_platform"},
    {"case": "base_key_down_ok", "kind": "key_down", "key": "a", "capabilities": ["software_injection", "cross_observation_hold"], "expect": "ok"},
    {"case": "base_key_up_requires_hold", "kind": "key_up", "key": "a", "capabilities": ["software_injection"], "expect": "unsupported_platform"},
    {"case": "invalid_key_name", "kind": "key_tap", "key": "ctrl+p", "capabilities": ["software_injection"], "expect": "invalid_argument"},
    {"case": "button_down_requires_hold", "kind": "button_down", "button": "left", "capabilities": ["software_injection"], "expect": "unsupported_platform"},
    {"case": "button_down_ok", "kind": "button_down", "button": "left", "capabilities": ["software_injection", "cross_observation_hold"], "expect": "ok"},
    {"case": "button_up_ok", "kind": "button_up", "button": "middle", "capabilities": ["cross_observation_hold", "kernel_virtual_device"], "expect": "ok"},
    {"case": "button_tap_without_dwell", "kind": "button_tap", "button": "right", "capabilities": ["software_injection"], "expect": "ok"},
    {"case": "button_tap_with_dwell", "kind": "button_tap", "button": "right", "dwell_ms": 800, "capabilities": ["software_injection", "timed_press"], "expect": "ok"},
    {"case": "invalid_button", "kind": "button_tap", "button": "wheel", "capabilities": ["software_injection"], "expect": "invalid_argument"},
    {"case": "smooth_move_requires_capability", "kind": "smooth_move", "x": 10, "y": 10, "duration_ms": 300, "capabilities": ["software_injection"], "expect": "unsupported_platform"},
    {"case": "smooth_move_ok", "kind": "smooth_move", "x": 10, "y": 10, "duration_ms": 300, "path_points": 16, "capabilities": ["smooth_move", "software_injection"], "expect": "ok"},
    {"case": "smooth_move_defaults_points", "kind": "smooth_move", "x": 0, "y": 0, "duration_ms": 600, "capabilities": ["smooth_move", "software_injection"], "expect": "ok"},
    {"case": "smooth_move_duration_under_min", "kind": "smooth_move", "duration_ms": 49, "capabilities": ["smooth_move", "software_injection"], "expect": "invalid_argument"},
    {"case": "smooth_move_duration_over_max", "kind": "smooth_move", "duration_ms": 2001, "capabilities": ["smooth_move", "software_injection"], "expect": "result_too_large"},
    {"case": "smooth_move_points_over_max", "kind": "smooth_move", "duration_ms": 300, "path_points": 65, "capabilities": ["smooth_move", "software_injection"], "expect": "result_too_large"},
    {"case": "no_injection_source", "kind": "key_tap", "key": "tab", "capabilities": ["smooth_move"], "expect": "unsupported_platform"},
    {"case": "command_budget_exhausted", "kind": "key_tap", "key": "tab", "capabilities": ["software_injection"], "commands": 64, "expect": "result_too_large"},
    {"case": "held_budget_exhausted", "kind": "key_down", "key": "a", "capabilities": ["software_injection", "cross_observation_hold"], "held": 4, "expect": "result_too_large"},
    {"case": "negative_dwell", "kind": "key_tap", "key": "a", "dwell_ms": -1, "capabilities": ["software_injection"], "expect": "invalid_argument"}
  ],
  "receipt": {
    "version": 1,
    "outcomes": ["admitted", "delivered", "holding", "released", "uncertain"],
    "fields": [
      "state",
      "outcome",
      "state_version",
      "command_sequence",
      "budget_version",
      "commands_remaining",
      "idle_budget_ms_remaining",
      "held_keys",
      "held_buttons",
      "side_effect_may_have_occurred",
      "release_confirmed",
      "cancelled",
      "error"
    ],
    "note": "release_confirmed is true only in the released state; holding is never reported through the legacy input_released flag"
  }
}
