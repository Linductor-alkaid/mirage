# DEC-068: immutable build-time assets; installed products never download models.
option(MIRAGE_BUNDLE_VISION "Bundle the verified PP-OCRv5 resources" ${MIRAGE_ENABLE_NATIVE_FRONTEND})
set(MIRAGE_VISION_SOURCE_DIR "" CACHE PATH "Offline source directory for the locked vision assets")
if(MIRAGE_BUNDLE_VISION)
    if(NOT MIRAGE_WITH_PPOCR)
        message(FATAL_ERROR "MIRAGE_BUNDLE_VISION requires MIRAGE_WITH_PPOCR=ON; disable both for a thin developer build")
    endif()
    find_package(Python3 COMPONENTS Interpreter REQUIRED)
    file(READ "${CMAKE_SOURCE_DIR}/packaging/vision/resources.lock.json" _vision_lock)
    string(JSON _vision_commit GET "${_vision_lock}" commit)
    if(MIRAGE_VISION_SOURCE_DIR)
        set(_vision_source "${MIRAGE_VISION_SOURCE_DIR}")
    else()
        set(_vision_source "${CMAKE_BINARY_DIR}/vision-source/${_vision_commit}")
    endif()
    string(JSON _vision_count LENGTH "${_vision_lock}" source_artifacts)
    math(EXPR _vision_last "${_vision_count} - 1")
    foreach(_i RANGE ${_vision_last})
        string(JSON _file MEMBER "${_vision_lock}" source_artifacts ${_i})
        string(JSON _hash GET "${_vision_lock}" source_artifacts "${_file}")
        set(_path "${_vision_source}/${_file}")
        if(NOT EXISTS "${_path}")
            if(MIRAGE_VISION_SOURCE_DIR)
                message(FATAL_ERROR "Missing offline vision artifact: ${_file}")
            endif()
            get_filename_component(_parent "${_path}" DIRECTORY)
            file(MAKE_DIRECTORY "${_parent}")
            file(DOWNLOAD "https://raw.githubusercontent.com/nihui/ncnn-android-ppocrv5/${_vision_commit}/${_file}"
                "${_path}.download" EXPECTED_HASH "SHA256=${_hash}" TLS_VERIFY ON
                TIMEOUT 120 INACTIVITY_TIMEOUT 30 STATUS _status)
            list(GET _status 0 _code)
            if(NOT _code EQUAL 0)
                file(REMOVE "${_path}.download")
                message(FATAL_ERROR "Cannot download locked vision artifact ${_file}: ${_status}")
            endif()
            file(RENAME "${_path}.download" "${_path}")
        endif()
        file(SHA256 "${_path}" _actual)
        if(NOT _actual STREQUAL _hash)
            message(FATAL_ERROR "Locked vision artifact hash mismatch: ${_file}")
        endif()
    endforeach()
    set(MIRAGE_VISION_BUNDLE_DIR "${CMAKE_BINARY_DIR}/share/mirage/vision/ppocrv5-mobile-v1")
    execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_SOURCE_DIR}/tools/prepare_vision_bundle.py"
        --source "${_vision_source}" --output "${MIRAGE_VISION_BUNDLE_DIR}"
        --lock "${CMAKE_SOURCE_DIR}/packaging/vision/resources.lock.json"
        RESULT_VARIABLE _result OUTPUT_QUIET ERROR_VARIABLE _error)
    if(NOT _result EQUAL 0)
        message(FATAL_ERROR "Vision bundle preparation failed: ${_error}")
    endif()
    file(COPY "${CMAKE_SOURCE_DIR}/packaging/vision/notices/" DESTINATION "${MIRAGE_VISION_BUNDLE_DIR}/notices")
    file(COPY "${CMAKE_SOURCE_DIR}/packaging/vision/resources.lock.json" DESTINATION "${MIRAGE_VISION_BUNDLE_DIR}")
endif()

# DEC-097: callers explicitly supply the audited converted model directory.
# Conversion/training frameworks are not product build or runtime dependencies.
set(MIRAGE_YOLO_MODEL_DIR "" CACHE PATH "Offline directory containing locked converted UI detector assets")
if(MIRAGE_YOLO_MODEL_DIR)
    if(NOT MIRAGE_BUNDLE_VISION OR NOT MIRAGE_WITH_YOLO)
        message(FATAL_ERROR "MIRAGE_YOLO_MODEL_DIR requires MIRAGE_BUNDLE_VISION and MIRAGE_WITH_YOLO")
    endif()
    execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_SOURCE_DIR}/tools/prepare_yolo_bundle.py"
        --source "${MIRAGE_YOLO_MODEL_DIR}" --bundle "${MIRAGE_VISION_BUNDLE_DIR}"
        --lock "${CMAKE_SOURCE_DIR}/packaging/vision/yolo.lock.json"
        RESULT_VARIABLE _yolo_result ERROR_VARIABLE _yolo_error)
    if(NOT _yolo_result EQUAL 0)
        message(FATAL_ERROR "YOLO bundle preparation failed: ${_yolo_error}")
    endif()
endif()
